{
  "manifest_version": 3,
  "name": "Open Coupons",
  "short_name": "Open Coupons",
  "version": "0.3.0",
  "description": "Tries the known coupon codes on a checkout page and keeps the one giving the lowest total, and lists price errors still live at the store. Collects no browsing or personal data.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Coupons",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "lib/domains.js",
        "lib/platforms.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "open-coupons@independent",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}